{
  "manifest_version": 3,
  "name": "Linear Ticket & Screenshot Creator",
  "version": "1.0.0",
  "description": "Capture page screenshots, annotate issues, and auto-map projects to create Linear tickets.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.linear.app/*",
    "https://*.linear.app/*",
    "https://*.amazonaws.com/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "action": {
    "default_title": "Create Linear Ticket",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/annotator/annotator.html",
        "assets/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
